{
  "name": "pyrocade",
  "version": "0.2.1",
  "description": "3D carousel front-end for emulators with built-in emulator downloader/updater",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "tauri dev",
    "tauri": "tauri",
    "build": "tauri build",
    "dist": "tauri build",
    "dist:macos:arm64": "tauri build --target aarch64-apple-darwin --bundles app,dmg",
    "dist:linux:arm64": "tauri build --target aarch64-unknown-linux-gnu --bundles appimage,deb,rpm",
    "prompts:build": "node scripts/build-prompts.js",
    "prompts:export": "electron scripts/export-prompts.cjs",
    "prompts:check": "electron scripts/check-prompts.cjs",
    "carousel:check": "electron scripts/check-carousel.cjs",
    "artwork:check": "node scripts/check-artwork.cjs && electron scripts/check-artwork-ui.cjs",
    "eshop:check": "electron scripts/check-eshop.cjs",
    "ui:check": "electron scripts/check-library-ui.cjs",
    "brand:build": "electron scripts/build-brand.cjs",
    "brand:check": "electron scripts/check-brand.cjs",
    "demo:record": "electron scripts/record-reddit-demo.cjs",
    "electron:start": "electron ."
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "electron": "^39.0.0",
    "electron-builder": "^26.18.0"
  },
  "productName": "PyroCade",
  "author": {
    "name": "Pyrodrifter",
    "email": "151417494+Pyrodrifter@users.noreply.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Pyrodrifter/PyroCade.git"
  },
  "build": {
    "appId": "com.pyrodrifter.pyrocade",
    "productName": "PyroCade",
    "copyright": "Copyright (c) 2026 Pyrodrifter",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "artwork.js",
      "emulators.json",
      "package.json",
      "LICENSE",
      "renderer/**/*",
      "!renderer/assets/prompts/png/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "renderer/assets/brand/pyrocade.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "PyroCade-Setup-${version}.exe",
      "shortcutName": "PyroCade",
      "installerIcon": "renderer/assets/brand/pyrocade.ico",
      "uninstallerIcon": "renderer/assets/brand/pyrocade.ico",
      "deleteAppDataOnUninstall": false
    },
    "publish": null,
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm",
        "pacman"
      ],
      "executableName": "pyrocade",
      "icon": "renderer/assets/brand/pyrocade-icon-512.png",
      "category": "Game",
      "synopsis": "3D carousel front end for emulators",
      "maintainer": "Pyrodrifter <151417494+Pyrodrifter@users.noreply.github.com>",
      "desktop": {
        "entry": {
          "Name": "PyroCade",
          "Comment": "3D carousel front end for emulators",
          "Categories": "Game;Emulator;",
          "Keywords": "emulator;games;launcher;"
        }
      }
    },
    "appImage": {
      "artifactName": "PyroCade-${version}-x86_64.AppImage"
    },
    "deb": {
      "artifactName": "pyrocade_${version}_amd64.deb"
    },
    "rpm": {
      "artifactName": "pyrocade-${version}.x86_64.rpm"
    },
    "pacman": {
      "artifactName": "pyrocade-${version}-x86_64.pkg.tar.zst"
    }
  },
  "homepage": "https://github.com/Pyrodrifter/PyroCade"
}
