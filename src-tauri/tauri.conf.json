{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PyroCade",
  "version": "0.2.1",
  "identifier": "com.pyrodrifter.pyrocade",
  "build": {
    "frontendDist": "../renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "PyroCade",
        "width": 1600,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 650,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": []
      },
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob: https: file:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost https:; font-src 'self' data:; media-src 'self' asset: http://asset.localhost data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": ["app", "dmg", "appimage", "deb", "rpm", "nsis", "msi"],
    "windows": {
      "nsis": {
        "installerIcon": "../renderer/assets/brand/pyrocade.ico"
      }
    },
    "android": {
      "minSdkVersion": 24
    },
    "category": "Game",
    "shortDescription": "3D carousel front end for emulators",
    "longDescription": "A glass-styled emulator front end with a 3D library, animated physical media, six browsing layouts and a built-in emulator downloader and updater.",
    "icon": [
      "../renderer/assets/brand/pyrocade-icon-512.png",
      "../renderer/assets/brand/pyrocade.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      },
      "rpm": {
        "depends": ["webkit2gtk4.1", "gtk3"]
      }
    }
  }
}
