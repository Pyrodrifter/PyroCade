[
  {
    "id": "duckstation",
    "name": "DuckStation",
    "systems": [
      "ps1"
    ],
    "args": "-batch -fullscreen {rom}",
    "platforms": {
      "windows": {
        "x86_64": {
          "source": {
            "type": "github",
            "repo": "stenzek/duckstation",
            "prerelease": true
          },
          "asset": "^duckstation-windows-x64-release\\.zip$",
          "exe": "^duckstation-qt.*\\.exe$"
        }
      },
      "linux": {
        "x86_64": {
          "source": {
            "type": "github",
            "repo": "stenzek/duckstation",
            "prerelease": true
          },
          "asset": "^DuckStation-x64.AppImage$",
          "exe": "^DuckStation-x64.AppImage$"
        },
        "arm64": {
          "source": {
            "type": "github",
            "repo": "stenzek/duckstation",
            "prerelease": true
          },
          "asset": "^DuckStation-arm64\\.AppImage$",
          "exe": "^DuckStation-arm64\\.AppImage$"
        }
      },
      "macos": {
        "arm64": {
          "source": {
            "type": "github",
            "repo": "stenzek/duckstation",
            "prerelease": true
          },
          "asset": "^duckstation-mac-release\\.zip$",
          "exe": "^duckstation-qt$",
          "appBundle": "\\.app$"
        }
      }
    }
  },
